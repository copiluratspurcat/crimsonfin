{
  "name": "crimsonfin-client",
  "version": "2.5.9",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "Custom Jellyfin client, secure gateway and FileList-backed media requests",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:visual": "node tests/visual/smoke.mjs",
    "typecheck": "tsc --noEmit -p web",
    "mock": "node tools/mock-server.mjs",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis --linux AppImage deb --publish never",
    "pack:linux": "npm run build && electron-builder --linux deb AppImage --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.1",
    "hls.js": "^1.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "app.crimsonfin.client",
    "productName": "CrimsonFin",
    "icon": "build/icon.png",
    "directories": {
      "output": "releases"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "CrimsonFin Project <noreply@github.com>",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "copiluratspurcat",
        "repo": "crimsonfin"
      }
    ]
  },
  "author": "CrimsonFin Project <noreply@github.com>",
  "desktopName": "CrimsonFin",
  "homepage": "https://github.com/copiluratspurcat/crimsonfin",
  "repository": {
    "type": "git",
    "url": "https://github.com/copiluratspurcat/crimsonfin.git"
  }
}
