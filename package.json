{
  "name": "crimsonfin",
  "version": "1.2.5",
  "description": "CrimsonFin — a cinematic desktop client for Jellyfin",
  "author": {
    "name": "copiluratspurcat",
    "email": "copiluratspurcat@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "vite build",
    "pack:linux": "npm run build && electron-builder --linux deb --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win nsis --publish never",
    "release:win": "npm run build && electron-builder --win nsis --publish never",
    "release:linux": "npm run build && electron-builder --linux deb --x64 --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "build": "^0.1.4",
    "electron-updater": "^6.6.2",
    "hls.js": "^1.6.15",
    "lucide": "^0.468.0",
    "start": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.crimsonfin.desktop",
    "productName": "CrimsonFin",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "assets/crimsonfin.png",
      "artifactName": "CrimsonFin-${version}-Linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/crimsonfin.ico",
      "artifactName": "CrimsonFin-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "CrimsonFin-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appImage": {
      "artifactName": "CrimsonFin-${version}-Linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "CrimsonFin-${version}-Linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/copiluratspurcat/crimsonfin.git"
  }
}
