# Add to /etc/nginx/sites-available/crimsonfin and enable it.
# This new port is a proxy. Keep existing Jellyfin on 127.0.0.1:8096.
server {
    listen 8097;
    server_name _;

    # Desktop requests /requests/api/* become /api/* on the Python service.
    location ^~ /requests/ {
        client_max_body_size 20k;
        proxy_pass http://127.0.0.1:8787/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Emby-Token $http_x_emby_token;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    # Everything else stays on Jellyfin, including video, image, WebSockets.
    location / {
        proxy_pass http://127.0.0.1:8096;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
