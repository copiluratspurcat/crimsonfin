# SERVER: copy to .env and set strong unique values. Never commit .env.
NODE_ENV=production
PORT=8099
BIND_HOST=127.0.0.1
JELLYFIN_URL=http://127.0.0.1:8096
# Must be the ACTUAL Funnel hostname after setup, no trailing slash.
PUBLIC_ORIGIN=https://your-device.your-tailnet.ts.net
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
DATA_DIR=./data
# Optional FileList API metadata search; credentials remain server-side.
FILELIST_USERNAME=
FILELIST_PASSKEY=

# Optional: private FileList RSS URL; keep it server-side
FILELIST_RSS_URL=

# Optional: qBittorrent Web UI for approved request downloads. Must be on loopback.
QBIT_URL=http://127.0.0.1:8877
QBIT_USERNAME=
QBIT_PASSWORD=

# Server scripts only (subtitle audit, episode metadata repair): a dedicated Jellyfin API key.
# The scripts only talk to a Jellyfin on loopback.
JELLYFIN_METADATA_API_KEY=

# Optional pinned LAN HTTPS endpoint (requires a certificate and private key).
LOCAL_ORIGIN=
LOCAL_TLS_CERT_PATH=
LOCAL_TLS_KEY_PATH=
LOCAL_TLS_PORT=9443

# Existing Jellyfin Movies and Shows library roots; separate paths with commas.
# Downloads select the drive with the most unreserved free space automatically.
MEDIA_MOVIE_DIRS=/mnt/ADATA/Movies,/mnt/WD1TBLU/movies
MEDIA_SERIES_DIRS=/mnt/ADATA/Shows,/mnt/ADATA/TV Shows,/mnt/WD1TBLU/shows

# Optional. Absolute path to ffsubsync on the gateway; ffmpeg must be on PATH.
# The gateway must be able to read Jellyfin's local media paths.
SUBTITLE_SYNC_COMMAND=

# Optional. Local copy of the opensubtitles.org dataset for the Romanian subtitle audit
# (scripts/romanian-subtitle-audit.py). Looked up on disk: no network, no daily quota.
# OPENSUBS_METADATA_DB: subtitles_all.db built from the official subtitles_all.txt.gz export.
# OPENSUBS_DUMP_DIRS: folders (':'-separated) holding the dump release .db files, e.g. 95xxxxx.db.
OPENSUBS_METADATA_DB=
OPENSUBS_DUMP_DIRS=

# Optional TMDB API Read Access Token for English and Romanian title variants.
# Without it, the switch uses the titles Jellyfin already has.
TMDB_READ_ACCESS_TOKEN=
